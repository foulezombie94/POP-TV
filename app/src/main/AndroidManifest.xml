<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".platform.recovery.PopApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="Pop TV"
        android:supportsRtl="true"
        android:theme="@style/Theme.PopTv">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".platform.recovery.RecoveryActivity" android:exported="true"
            android:label="Retour accueil Free" android:screenOrientation="landscape" />
        <activity android:name=".features.control.ControlCenterActivity" android:exported="false"
            android:theme="@style/Theme.PopTvOverlay" android:screenOrientation="landscape" />

        <!-- tvOS Settings. Launched from the home screen's Settings tile. -->
        <activity
            android:name=".features.settings.SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:exported="false"
            android:screenOrientation="landscape"
            android:taskAffinity="com.poptv.launcher.settings" />

        <!-- tvOS Search with the linear keyboard. -->
        <activity
            android:name=".features.search.SearchActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:exported="false"
            android:screenOrientation="landscape"
            android:taskAffinity="com.poptv.launcher.search"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- System-wide tvOS chrome: Control Center + App Switcher, drawn as accessibility overlays. -->
        <service
            android:name=".features.control.SystemUiService"
            android:exported="false"
            android:process=":system"
            android:label="Contrôles Pop TV"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/system_ui_service" />
        </service>

        <!-- Aerial screensaver. -->
        <service
            android:name=".features.screensaver.aerial.AerialDreamService"
            android:exported="true"
            android:label="Aerial"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/aerial_dream" />
        </service>

        <!-- Prayer-times dashboard screen saver (Baghdad, Jafari) with weather and BTC. -->
        <service
            android:name=".features.screensaver.dashboard.PrayerDashboardDream"
            android:exported="true"
            android:label="Prayer Times"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dashboard_dream" />
        </service>
    </application>
</manifest>
